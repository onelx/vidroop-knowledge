# Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=service_role_jwt...

# Cifrado de credenciales en la BD ----------------------------------
# 32 bytes en hex (64 chars). Genera con: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# GitHub dispatch (para que la API dispare workflows del crawler) ---
GITHUB_REPO_OWNER=onelx
GITHUB_REPO_NAME=vidroop-knowledge
GITHUB_DISPATCH_TOKEN=ghp_xxx_token_with_workflow_scope

# API externa --------------------------------------------------------
# Lista coma-separada de orígenes permitidos por CORS
API_ALLOWED_ORIGINS=

# Panel admin (Basic Auth en proxy.ts) ------------------------------
# Protege /admin/* y /api/admin/*. Sin ADMIN_PASSWORD el admin queda cerrado (503).
ADMIN_USER=admin
ADMIN_PASSWORD=
